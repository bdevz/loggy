PORT=3000
# Socket Mode deployment (one Slack installation per process).
# SLACK_WORKSPACE_ID=T123
# SLACK_APP_TOKEN_T123=xapp-...
# Set this in a deployed Slack app. Omit it for local mode.
SLACK_SIGNING_SECRET=
# Use workspace-scoped names in production. Replace T123 with the Slack team ID.
SLACK_BOT_TOKEN_T123=
LOG1_ACTOR_TOKEN_T123=
# A global token is accepted only with its matching workspace ID.
# SLACK_BOT_TOKEN=
# SLACK_BOT_TOKEN_WORKSPACE_ID=T123
# LOG1_ACTOR_TOKEN=
# LOG1_ACTOR_TOKEN_WORKSPACE_ID=T123
